# Calendar — servicio de escritorio.
#
# Corre como servicio de sistema (ver ../deploy/) con `lux --no-watch ./daemon` y
# no abre ninguna ventana: guarda una réplica del calendario, la sincroniza con el
# servidor y lanza los avisos, aunque la ventana esté cerrada. La app de escritorio
# (../app) es sólo la interfaz y le habla por HTTP en el bucle local.
#
#   store.lux      esquema, ajustes y registro de sucesos
#   remote.lux     cliente de la API del servidor de Calendar
#   data.lux       la réplica: cambios locales, cola de envío y lectura
#   sync.lux       enviar la cola y traer lo nuevo
#   reminders.lux  avisos de escritorio
#   api.lux        API local para la ventana

import sqlite
import os
import time
import json
import http
import hash
import regex
import rrule

app:
    name   "Calendar (servicio)"
    port   env("CALENDAR_DAEMON_PORT", "7879")
    # Sólo esta máquina: la API puede cambiar el calendario.
    host   "127.0.0.1"
    max_body "1MB"

    log:
        level "info"
        access false

    sqlite:
        file env("CALENDAR_DAEMON_DB", "./state.db")
        pool 2
