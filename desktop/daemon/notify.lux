# Cómo se lanza un aviso. En escritorio, notify-send al bus de sesión del usuario; en Android
# (android/overlay/notify.lux, que sustituye a este fichero) es una notificación del sistema.

fn string runtime_dir():
    return os.getenv("CALENDAR_RUNTIME_DIR", "/run/user/" + os.getenv("CALENDAR_UID", "1000"))

fn bool desktop_notify(string title, string body):
    try:
        Json res = await os.run(os.getenv("CALENDAR_NOTIFY_CMD", "notify-send"), ["-a", "Calendar", "-i", "calendar-desktop", "-u", "normal", "-t", "0", title, body], {
            "timeout_ms": 5000,
            "env": { "DBUS_SESSION_BUS_ADDRESS": "unix:path=" + runtime_dir() + "/bus", "XDG_RUNTIME_DIR": runtime_dir() }
        })
        return res["status"] == 0
    catch e:
        return false
